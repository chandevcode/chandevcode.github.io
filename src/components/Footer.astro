---
const today = new Date();
const site = new URL(Astro.site ?? 'https://chandevcode.github.io/');
---

<footer class="site-footer">
	<div class="page">
		<div class="footer-inner">
			<p class="fine">&copy; {today.getFullYear()} Putu Chandra</p>
			<nav class="footer-links" aria-label="Footer">
				<a href="/blog/">Blog</a>
				<a href="/about/">About</a>
				<a href={new URL('rss.xml', site)}>RSS</a>
			</nav>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--line);
	}

	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		padding: 2rem 0;
	}

	.fine {
		margin: 0;
		font-size: 0.875rem;
		color: var(--text-3);
	}

	.footer-links {
		display: flex;
		gap: 1.25rem;
	}

	.footer-links a {
		font-size: 0.875rem;
		color: var(--text-2);
		text-decoration: none;
	}

	.footer-links a:hover {
		color: var(--accent);
	}

	@media (max-width: 480px) {
		.footer-inner {
			justify-content: center;
			text-align: center;
			padding: 1.75rem 0;
		}
	}
</style>
