---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Not found - ${SITE_TITLE}`} description="This page does not exist." />
	</head>
	<body>
		<Header />
		<main class="page notfound">
			<p class="code">404</p>
			<h1>Page not found</h1>
			<p class="lede">The link is broken or the page moved.</p>
			<a class="btn btn--primary" href="/">Back to the homepage</a>
		</main>
		<Footer />
	</body>
</html>

<style>
	.notfound {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		min-height: 60dvh;
		padding: 4rem 0 6rem;
		max-width: 34rem;
	}

	.code {
		font-size: 0.9375rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--accent);
	}

	h1 {
		margin-top: 0.75rem;
		font-size: clamp(1.9rem, 4.5vw, 2.6rem);
		letter-spacing: -0.025em;
	}

	.lede {
		margin-top: 0.9rem;
		color: var(--text-2);
	}

	.notfound .btn {
		margin-top: 2rem;
	}
</style>
