---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featured, ...rest] = posts;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main class="page">
			<header class="page-head">
				<h1 class="rise">Notes &amp; guides</h1>
				<p class="lede rise" style="--rise-delay: 90ms">
					Short, practical pieces on building a Shopify store that sells. Setup, conversion,
					and the small tools that do the heavy lifting.
				</p>
			</header>

			{posts.length === 0 ? (
				<p class="empty">No posts yet. Check back soon.</p>
			) : (
				<section aria-label="Blog posts">
					{featured && (
						<a class="featured" href={`/blog/${featured.id}/`}>
							<div class="featured-meta">
								<FormattedDate date={featured.data.pubDate} />
							</div>
							<h2 class="featured-title">{featured.data.title}</h2>
							{featured.data.description && (
								<p class="excerpt">{featured.data.description}</p>
							)}
							<span class="featured-cta">Read the note <span aria-hidden="true">&rarr;</span></span>
						</a>
					)}

					{rest.length > 0 && (
						<ul class="post-list">
							{rest.map((post) => (
								<li>
									<a class="row" href={`/blog/${post.id}/`}>
										<time class="row-date" datetime={post.data.pubDate.toISOString()}>
											<FormattedDate date={post.data.pubDate} />
										</time>
										<span class="row-body">
											<h3>{post.data.title}</h3>
											{post.data.description && <p>{post.data.description}</p>}
										</span>
										{post.data.heroImage && (
											<Image
												class="row-thumb"
												width={112}
												height={72}
												loading="lazy"
												src={post.data.heroImage}
												alt=""
											/>
										)}
									</a>
								</li>
							))}
						</ul>
					)}
				</section>
			)}
		</main>

		<Footer />
	</body>
</html>

<style>
	/* --- Page header --- */
	.page-head {
		padding: clamp(4rem, 10vw, 6.5rem) 0 clamp(2.5rem, 7vw, 4rem);
		max-width: 46rem;
	}

	.page-head h1 {
		font-size: clamp(2.25rem, 5.5vw, 3.4rem);
		line-height: 1.08;
		letter-spacing: -0.028em;
	}

	.lede {
		margin-top: 1.25rem;
		max-width: var(--measure);
		font-size: 1.125rem;
		line-height: 1.65;
		color: var(--text-2);
		text-wrap: pretty;
	}

	/* --- Featured post --- */
	.featured {
		display: block;
		padding: 2.25rem 0 2.5rem;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		text-decoration: none;
		color: inherit;
	}

	.featured-meta {
		font-size: 0.8125rem;
		color: var(--text-2);
	}

	.featured-title {
		margin-top: 0.65rem;
		max-width: 38rem;
		font-size: clamp(1.6rem, 3.5vw, 2.15rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
		text-wrap: balance;
		transition: color 0.18s ease;
	}

	.featured:hover .featured-title {
		color: var(--accent);
	}

	.excerpt {
		margin-top: 0.7rem;
		max-width: 52ch;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--text-2);
		text-wrap: pretty;
	}

	.featured-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 1.15rem;
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--accent);
	}

	.featured-cta span {
		transition: transform 0.18s ease;
	}

	.featured:hover .featured-cta span {
		transform: translateX(3px);
	}

	/* --- Post list --- */
	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.section[aria-label='Blog posts'] {
		padding-bottom: 4rem;
	}

	.row {
		display: grid;
		grid-template-columns: 9.5rem 1fr auto;
		align-items: center;
		gap: 1.75rem;
		padding: 1.35rem 0;
		border-bottom: 1px solid var(--line);
		color: inherit;
		text-decoration: none;
		transition: background-color 0.18s ease;
	}

	.row:hover {
		background: var(--bg-subtle);
	}

	.row:hover .row-body h3 {
		color: var(--accent);
	}

	.row-date {
		font-size: 0.8125rem;
		color: var(--text-2);
	}

	.row-body h3 {
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		transition: color 0.18s ease;
	}

	.row-body p {
		margin-top: 0.3rem;
		max-width: 52ch;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--text-2);
	}

	.row-thumb {
		width: 88px;
		height: 56px;
		border-radius: 8px;
		object-fit: cover;
	}

	.empty {
		padding: 3rem 0;
		color: var(--text-2);
	}

	/* --- Responsive --- */
	@media (max-width: 720px) {
		.page-head {
			padding-top: 3.5rem;
		}

		.row {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}

		.row-thumb {
			display: none;
		}
	}
</style>
