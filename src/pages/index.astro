---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const topics = [
	{
		label: 'Store setup',
		body: 'Theme, navigation, and the twenty settings that actually move the needle.',
	},
	{
		label: 'Conversion',
		body: 'Product pages, pricing psychology, and checkout friction you can delete today.',
	},
	{
		label: 'Apps & automation',
		body: 'The small stack that replaces a part-time ops hire.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main class="page">
			<!-- Hero -->
			<section class="hero">
				<h1 class="rise">
					Short, practical notes on building a Shopify store that sells.
				</h1>
				<p class="lede rise" style="--rise-delay: 90ms">
					No 4,000-word roundups. Just the setup, the tweaks, and the tools you can
					ship today.
				</p>
				<div class="actions rise" style="--rise-delay: 180ms">
					<a class="btn btn--primary" href="/blog/">Read the notes</a>
					<a class="btn" href="/about/">About this site</a>
				</div>
			</section>

			<!-- Latest posts -->
			<section class="section" aria-labelledby="latest">
				<div class="section-head">
					<h2 id="latest">Latest</h2>
					<a class="more" href="/blog/">
						All posts <span aria-hidden="true">&rarr;</span>
					</a>
				</div>

				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a class="row" href={`/blog/${post.id}/`}>
								<time class="row-date" datetime={post.data.pubDate.toISOString()}>
									<FormattedDate date={post.data.pubDate} />
								</time>
								<span class="row-body">
									<h3>{post.data.title}</h3>
									{post.data.description && <p>{post.data.description}</p>}
								</span>
								{post.data.heroImage && (
									<Image
										class="row-thumb"
										width={112}
										height={72}
										loading="lazy"
										src={post.data.heroImage}
										alt=""
									/>
								)}
							</a>
						</li>
					))}
				</ul>
			</section>

			<!-- Topics -->
			<section class="section topics" aria-labelledby="topics-head">
				<h2 id="topics-head" class="topics-title">What you'll find here</h2>
				<ul class="topics-grid">
					{topics.map((t) => (
						<li>
							<h3 class="topic-label">{t.label}</h3>
							<p>{t.body}</p>
						</li>
					))}
				</ul>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	/* --- Hero --- */
	.hero {
		padding: clamp(4.5rem, 12vw, 8.5rem) 0 clamp(3rem, 8vw, 5rem);
		max-width: 46rem;
	}

	.hero h1 {
		font-size: clamp(2.35rem, 6vw, 3.7rem);
		line-height: 1.08;
		letter-spacing: -0.028em;
	}

	.lede {
		margin-top: 1.4rem;
		max-width: var(--measure);
		font-size: 1.15rem;
		line-height: 1.65;
		color: var(--text-2);
		text-wrap: pretty;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.1rem;
	}

	/* --- Sections --- */
	.section {
		padding: clamp(3rem, 8vw, 5rem) 0;
		border-top: 1px solid var(--line);
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.5rem;
	}

	.section-head h2 {
		font-size: 1.4rem;
		letter-spacing: -0.015em;
	}

	.more {
		font-size: 0.9375rem;
		color: var(--text-2);
		text-decoration: none;
		white-space: nowrap;
	}

	.more:hover {
		color: var(--accent);
	}

	/* --- Post list --- */
	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.row {
		display: grid;
		grid-template-columns: 9.5rem 1fr auto;
		align-items: center;
		gap: 1.75rem;
		padding: 1.35rem 0;
		border-top: 1px solid var(--line);
		color: inherit;
		text-decoration: none;
		transition: background-color 0.18s ease;
	}

	.post-list li:last-child .row {
		border-bottom: 1px solid var(--line);
	}

	.row:hover {
		background: var(--bg-subtle);
	}

	.row:hover .row-body h3 {
		color: var(--accent);
	}

	.row-date {
		font-size: 0.8125rem;
		color: var(--text-2);
	}

	.row-body h3 {
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		transition: color 0.18s ease;
	}

	.row-body p {
		margin-top: 0.3rem;
		max-width: 52ch;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--text-2);
	}

	.row-thumb {
		width: 88px;
		height: 56px;
		border-radius: 8px;
		object-fit: cover;
	}

	/* --- Topics --- */
	.topics-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2.5rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}

	.topics-grid li {
		padding-right: 1.5rem;
		border-left: 1px solid var(--line);
		padding-left: 1.5rem;
	}

	.topics-grid li:first-child {
		padding-left: 0;
		border-left: 0;
	}

	.topic-label {
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.topics-grid p {
		margin-top: 0.55rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--text-2);
		text-wrap: pretty;
	}

	.topics-title {
		font-size: 1.4rem;
		letter-spacing: -0.015em;
	}

	/* --- Responsive --- */
	@media (max-width: 720px) {
		.hero {
			padding-top: 3.5rem;
		}

		.row {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}

		.row-thumb {
			display: none;
		}

		.topics-grid {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.topics-grid li {
			padding: 1.25rem 0;
			border-left: 0;
			border-top: 1px solid var(--line);
		}

		.topics-grid li:first-child {
			padding-top: 1.25rem;
			border-top: 1px solid var(--line);
		}
	}
</style>
