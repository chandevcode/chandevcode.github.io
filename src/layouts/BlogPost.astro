---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="page">
			<article>
				<header class="article-head">
					<div class="meta rise">
						<time datetime={pubDate.toISOString()}>
							<FormattedDate date={pubDate} />
						</time>
						{
							updatedDate && (
								<span class="updated">
									Updated <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
					<h1 class="rise" style="--rise-delay: 70ms">{title}</h1>
					{description && (
						<p class="deck rise" style="--rise-delay: 140ms">{description}</p>
					)}
				</header>

				{heroImage && (
					<figure class="hero-media rise" style="--rise-delay: 200ms">
						<Image width={1200} height={675} src={heroImage} alt="" />
					</figure>
				)}

				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page {
		max-width: 52rem;
	}

	.article-head {
		padding: clamp(4rem, 10vw, 6.5rem) 0 2.25rem;
		max-width: 44rem;
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		font-size: 0.8125rem;
		color: var(--text-2);
	}

	.meta time {
		font-weight: 600;
		color: var(--text-2);
	}

	.updated {
		padding-left: 0.9rem;
		border-left: 1px solid var(--line);
	}

	h1 {
		margin-top: 0.9rem;
		font-size: clamp(1.9rem, 4.5vw, 2.8rem);
		line-height: 1.12;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	.deck {
		margin-top: 1rem;
		max-width: 42ch;
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--text-2);
		text-wrap: pretty;
	}

	.hero-media {
		margin: 0 0 3rem;
	}

	.hero-media img {
		width: 100%;
		border-radius: var(--radius);
		border: 1px solid var(--line);
	}

	.prose {
		padding-bottom: 5rem;
	}

	@media (max-width: 720px) {
		.article-head {
			padding-top: 3.5rem;
		}

		.hero-media {
			margin-bottom: 2.25rem;
		}
	}
</style>
